<?xml version="1.0"?>
<!-- Sensors for Kalibr recording and bench tests: Arducam camera + Betaflight FC IMU over MSP.
     The bridge node block mirrors agiros/launch/bridges/msp_imu_only.launch (no RC/command path)
     and adds the IMU scaling/stamping params. Nothing in agilicious is modified.

     REQUIRED before use (see config/arducam_msp/README.md):
       * Betaflight CLI: set serial_update_rate_hz = 1000 ; save
       * imu_gyro_dps_per_lsb = 0.061035 (= 1/16.384, raw 2000 dps counts) was verified on
         2026-10-11 with imu_check.py (360 deg table turn -> 5956 counts*deg, implied 0.0604).
         The bridge's own default (1.0) is 16x too large; keep this launch's default.
     Stamp = receive time - stamp_offset_sec (reply path of the MSP round trip ~ 2 ms). -->
<launch>
  <arg name="launch_camera"        default="true"/>
  <arg name="port"                 default="/dev/ttyUSB0"/>
  <arg name="baudrate"             default="1000000"/>
  <arg name="imu_rate_hz"          default="200.0"/>
  <arg name="imu_gyro_dps_per_lsb" default="0.061035"/>  <!-- verified 2026-10-11, see header -->
  <arg name="imu_acc_lsb_per_g"    default="2024.0"/>  <!-- |acc| at rest = 9.69 with 2048 in two poses -> scale, not bias -->
  <arg name="stamp_offset_sec"     default="0.002"/>
  <arg name="imu_frame_id"         default="fc_imu"/>
  <arg name="publish_attitude"     default="true"/>  <!-- keep off: frees the MSP budget -->
  <arg name="attitude_rate_hz"     default="20.0"/>
  <arg name="poll_timeout_sec"     default="0.2"/>
  <arg name="poll_max_rtt_sec"     default="0.03"/>
  <arg name="slow_feedback_interval" default="60.0"/>
  <!-- camera -->
  <arg name="device"            default="/dev/video0"/>
  <arg name="fps"               default="30"/>
  <arg name="exposure_absolute" default="10"/>
  <arg name="gain"              default="10"/>
  <arg name="publish_color"     default="false"/>

  <group if="$(arg launch_camera)">
    <include file="$(find ov_msckf)/launch/arducam.launch">
      <arg name="device"            value="$(arg device)"/>
      <arg name="fps"               value="$(arg fps)"/>
      <arg name="exposure_absolute" value="$(arg exposure_absolute)"/>
      <arg name="gain"              value="$(arg gain)"/>
      <arg name="publish_color"     value="$(arg publish_color)"/>
    </include>
  </group>

  <node pkg="agiros" name="ros_to_msp_bridge" type="ros_to_msp_bridge" output="screen">
    <param name="port"                   value="$(arg port)"/>
    <param name="baudrate"               value="$(arg baudrate)"/>
    <param name="publish_attitude"       value="$(arg publish_attitude)"/>
    <param name="attitude_rate_hz"       value="$(arg attitude_rate_hz)"/>
    <param name="publish_imu"            value="true"/>
    <param name="imu_rate_hz"            value="$(arg imu_rate_hz)"/>
    <param name="imu_gyro_dps_per_lsb"   value="$(arg imu_gyro_dps_per_lsb)"/>
    <param name="imu_acc_lsb_per_g"      value="$(arg imu_acc_lsb_per_g)"/>
    <param name="stamp_offset_sec"       value="$(arg stamp_offset_sec)"/>
    <param name="imu_frame_id"           value="$(arg imu_frame_id)"/>
    <param name="poll_timeout_sec"       value="$(arg poll_timeout_sec)"/>
    <param name="poll_max_rtt_sec"       value="$(arg poll_max_rtt_sec)"/>
    <param name="publish_raw_rc"         value="false"/>
    <param name="use_rawrc_from_command" value="false"/>
    <param name="publish_sent_raw_rc"    value="false"/>
    <param name="rawrc_log_enabled"      value="false"/>
    <param name="slow_feedback_interval" value="$(arg slow_feedback_interval)"/>
  </node>
</launch>
