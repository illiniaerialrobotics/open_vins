<launch>
  <!-- imu -> base_link extrinsic -->
  <node pkg="tf2_ros" type="static_transform_publisher" name="imu_base_link_static"
        args="0 0.0602 0.0 0.0 -1.57 1.57 imu base_link" />

  <!-- OpenVINS odom -> base_link in global frame (requires world->global TF from elsewhere if needed).
       Twist linear/angular rotated into global (non-standard vs nav_msgs child_frame_id convention). -->
  <node pkg="ov_msckf" type="tf_odom_rot.py" name="odom_frame_transformer" output="screen">
    <param name="express_twist_in_global" value="true"/>
  </node>
</launch>
