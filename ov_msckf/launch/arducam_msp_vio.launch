<?xml version="1.0"?>
<!-- OpenVINS mono VIO on the Arducam + FC-IMU pair (config/arducam_msp).
     Live:    roslaunch ov_msckf arducam_msp_vio.launch imu_gyro_dps_per_lsb:=<value>
     Offline: roslaunch ov_msckf arducam_msp_vio.launch dobag:=true bag:=/path/to.bag [bag_rate:=1]
              (sensors are not started when dobag is true)
     dosave:=true writes /tmp/traj_estimate.txt for ov_eval. -->
<launch>
  <arg name="dobag"          default="false"/>
  <arg name="bag"            default=""/>
  <arg name="bag_start"      default="0"/>
  <arg name="bag_rate"       default="1"/>
  <arg name="launch_sensors" default="$(eval not arg('dobag'))"/>
  <arg name="imu_gyro_dps_per_lsb" default="0.061035"/>  <!-- verified 2026-10-11; used only when launch_sensors -->
  <arg name="verbosity"      default="INFO"/>
  <arg name="config_path"    default="$(find ov_msckf)/../config/arducam_msp/estimator_config.yaml"/>
  <arg name="dosave"         default="false"/>
  <arg name="path_est"       default="/tmp/traj_estimate.txt"/>
  <arg name="dotime"         default="false"/>
  <arg name="path_time"      default="/tmp/traj_timing.txt"/>
  <!-- imu -> base_link extrinsic for the FC IMU: PLACEHOLDER identity, measure on the airframe -->
  <arg name="imu_base_link_tf" default="0 0 0 0 0 0"/>
  <arg name="rviz"           default="false"/>   <!-- open rviz with the OpenVINS display config -->

  <group if="$(arg launch_sensors)">
    <include file="$(find ov_msckf)/launch/arducam_msp_sensors.launch">
      <arg name="imu_gyro_dps_per_lsb" value="$(arg imu_gyro_dps_per_lsb)"/>
    </include>
  </group>

  <include file="$(find ov_msckf)/launch/subscribe.launch">
    <arg name="config"      value="arducam_msp"/>
    <arg name="config_path" value="$(arg config_path)"/>
    <arg name="verbosity"   value="$(arg verbosity)"/>
    <arg name="max_cameras" value="1"/>
    <arg name="use_stereo"  value="false"/>
    <arg name="dobag"       value="$(arg dobag)"/>
    <arg name="bag"         value="$(arg bag)"/>
    <arg name="bag_start"   value="$(arg bag_start)"/>
    <arg name="bag_rate"    value="$(arg bag_rate)"/>
    <arg name="dosave"      value="$(arg dosave)"/>
    <arg name="path_est"    value="$(arg path_est)"/>
    <arg name="dotime"      value="$(arg dotime)"/>
    <arg name="path_time"   value="$(arg path_time)"/>
  </include>

  <node pkg="tf2_ros" type="static_transform_publisher" name="imu_base_link_static"
        args="$(arg imu_base_link_tf) imu base_link"/>
  <node pkg="ov_msckf" type="tf_odom_rot.py" name="odom_frame_transformer" output="screen"/>
  <!-- world frame with a defined heading: origin + yaw of the IMU at the first pose, z up.
       Output /vio_world_align/odom_world (frame world, child imu) and the static TF world->global. -->
  <node pkg="ov_msckf" type="vio_world_align.py" name="vio_world_align" output="screen">
    <param name="yaw_offset_deg" value="0.0"/>
  </node>
  <group if="$(arg rviz)">
    <node pkg="rviz" type="rviz" name="rviz" args="-d $(find ov_msckf)/launch/display.rviz"/>
  </group>
</launch>
